# Ollama local API
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=ornith-1.5:9b
OLLAMA_NUM_CTX=65536
# Examples: 10m, 30m, 0 (unload after response); default 10m
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT=300

# Local application
WEB_HOST=127.0.0.1
WEB_PORT=8765
DATABASE_PATH=./data/agent.sqlite3
WORKSPACE_PATH=./workspace
MAX_TOOL_ROUNDS=80
# If true, interrupted/paused tasks are retried on startup (may repeat tool calls).
AUTO_RESUME_TASKS=false

# Conversation-scoped rootless Podman + SWE-ReX sandbox
SANDBOX_ENABLED=true
PODMAN_PATH=podman
SANDBOX_IMAGE=localhost/localagent-sandbox:ubuntu24.04
SANDBOX_NETWORK=localagent-sandbox-internal-test
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
SANDBOX_CONTAINER_PORT=8000
SANDBOX_PROXY_REQUIRED=true
XRAY_PROXY_CONTAINER=localagent-xray-proxy
# Debug trace is disabled by default; UI values override these environment defaults.
DEBUG_LLM_TRACE=false
DEBUG_LLM_THINKING=false
SWEREX_TIMEOUT=10

# Terminal facade: return to the model after 10s without new output;
# if output continues, wait up to 300s in one tool call.
TERMINAL_IDLE_TIMEOUT_SECONDS=10
TERMINAL_MAX_WAIT_SECONDS=300
