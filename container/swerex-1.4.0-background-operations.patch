+def test_independent_sessions_run_concurrently():
+    async def scenario():
+        runtime = LocalRuntime()
+        await runtime.create_session(CreateBashSessionRequest(session="a"))
+        await runtime.create_session(CreateBashSessionRequest(session="b"))
+        a, b = await asyncio.gather(
+            runtime.start_operation(StartOperationRequest(
+                action=BashAction(command="sleep 0.3; echo A", session="a"),
+                idempotency_key=str(uuid.uuid4()),
+            )),
+            runtime.start_operation(StartOperationRequest(
+                action=BashAction(command="sleep 0.3; echo B", session="b"),
+                idempotency_key=str(uuid.uuid4()),
