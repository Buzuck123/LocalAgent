+    async def start_operation(self, request: StartOperationRequest) -> StartOperationResponse:
+        if self._shell is None:
+            raise SessionNotInitializedError("shell not initialized")
+        action = request.action
+        if not request.idempotency_key:
+            raise ValueError("idempotency_key must not be empty")
+        if action.timeout is not None and action.timeout <= 0:
+            raise ValueError("operation timeout must be positive or None")
+        if action.session != self.request.session:
+            raise ValueError("Action session does not match the target Bash session")
+        fingerprint = action.model_dump_json()
+        async with self._operation_lock:
+            previous = self._idempotency.get(request.idempotency_key)
+            if previous:
+                old_fingerprint, old_id = previous
+                if old_fingerprint != fingerprint:
+                    raise ValueError("Idempotency key was already used with a different action")
+                if not old_id or old_id not in self._operations:
+                    raise RuntimeError("Idempotency key is outside the retained operation history; refusing to rerun")
+                old = self._operations[old_id]
+                return StartOperationResponse(
+                    operation_id=old.operation_id, session=self.request.session,
+                    state=old.state, created_at=old.created_at,
+                )
+            if self._operation and self._operation.state in ("running", "waiting_input"):
+                raise RuntimeError(
+                    f"Session {self.request.session!r} already has active operation {self._operation.operation_id}"
+                )
+            now = time.time()
+            operation = _BackgroundOperation(
+                operation_id=str(uuid.uuid4()), idempotency_key=request.idempotency_key,
+                fingerprint=fingerprint, created_at=now, started_at=now,
+                interactive=action.is_interactive_command or bool(action.expect),
+                exit_prefix=f"REXEXIT{uuid.uuid4().hex}START",
+                exit_suffix=f"REXEXIT{uuid.uuid4().hex}END",
+            )
+            operation.capture = _OutputCapture(
+                prompt=self._ps1,
+                exit_prefix=operation.exit_prefix,
+                exit_suffix=operation.exit_suffix,
+            )
+            self._operation = operation
+            self._operations[operation.operation_id] = operation
+            self._idempotency[request.idempotency_key] = (fingerprint, operation.operation_id)
+            # Retain a bounded number of output buffers. Keep idempotency tombstones
+            # so an evicted key is rejected rather than accidentally launching again.
+            if len(self._operations) > 32:
+                for old_id, old_op in list(self._operations.items()):
