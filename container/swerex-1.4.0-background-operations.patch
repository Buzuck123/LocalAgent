+import asyncio
+
+from starlette.responses import Response
+
+from swerex.server import ResponseManager
+
+
+def test_concurrent_request_id_is_executed_once():
+    async def scenario():
+        manager = ResponseManager(ttl=60, max_entries=10)
+        owner, cached, event = await manager.begin("same-request")
+        assert owner is True
+        assert cached is None
+        assert event is not None
+
+        duplicate_task = asyncio.create_task(manager.begin("same-request"))
+        await asyncio.sleep(0.02)
+        assert not duplicate_task.done()
+
+        response = await manager.finish(
+            "same-request", event, Response(content=b"stable", status_code=200)
+        )
+        assert response.body == b"stable"
+
+        duplicate_owner, duplicate_response, duplicate_event = await duplicate_task
+        assert duplicate_owner is False
+        assert duplicate_event is None
+        assert duplicate_response is not None
+        assert duplicate_response.body == b"stable"
+
+    asyncio.run(scenario())
+
+
+def test_http_background_operation_routes_and_retries():
+    from fastapi.testclient import TestClient
+
+    import swerex.server as server
+    from swerex.runtime.local import LocalRuntime
+
+    server.runtime = LocalRuntime()
+    with TestClient(server.app) as client:
+        created = client.post(
+            "/create_session", json={"session": "http-test", "session_type": "bash"}
+        )
+        assert created.status_code == 200
+        payload = {
+            "action": {"command": "echo from-http", "session": "http-test"},
+            "idempotency_key": "http-idempotency-key",
+        }
+        first = client.post("/start_operation", json=payload, headers={"X-Request-ID": "same-http-id"})
+        retry = client.post("/start_operation", json=payload, headers={"X-Request-ID": "same-http-id"})
+        assert first.status_code == 200
+        assert retry.status_code == 200
+        operation_id = first.json()["operation_id"]
+        assert retry.json()["operation_id"] == operation_id
+
+        cursor = 0
+        output = ""
+        for _ in range(20):
+            result = client.post("/get_operation", json={
+                "session": "http-test", "operation_id": operation_id,
+                "cursor": cursor, "wait_timeout": 0.2,
+            })
+            assert result.status_code == 200
+            payload_result = result.json()
+            output += payload_result["output"]
+            cursor = payload_result["next_cursor"]
+            if payload_result["state"] not in ("running", "waiting_input"):
+                break
+        assert payload_result["state"] == "completed"
+        assert "from-http" in output
+
+        closed = client.post("/close_session", json={"session": "http-test", "session_type": "bash"})
+        assert closed.status_code == 200
