+                    patterns = list(action.expect) + [self._ps1]
+                    idx = await self.shell.expect(patterns, timeout=None, async_=True)
+                    matched = patterns[idx]
+                    if idx == len(patterns) - 1:
+                        operation.expect_string = matched
