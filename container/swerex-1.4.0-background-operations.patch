+def test_timeout_is_real_and_session_recovers():
+    async def scenario():
+        runtime = LocalRuntime()
+        await runtime.create_session(CreateBashSessionRequest(session="timeout"))
+        started = await runtime.start_operation(StartOperationRequest(
+            action=BashAction(command="sleep 60", session="timeout", timeout=0.25),
+            idempotency_key=str(uuid.uuid4()),
+        ))
+        result, _ = await wait_terminal(runtime, "timeout", started.operation_id)
+        assert result.state == "timed_out"
+        assert "timeout" in result.failure_reason.lower()
+        legacy = await runtime.run_in_session(BashAction(command="echo recovered", session="timeout"))
+        assert legacy.exit_code == 0
+        await runtime.close()
+    run(scenario())
+
+
+def test_none_timeout_does_not_apply_a_hidden_short_limit():
+    async def scenario():
+        runtime = LocalRuntime()
+        await runtime.create_session(CreateBashSessionRequest(session="no-timeout"))
+        started = await runtime.start_operation(StartOperationRequest(
+            action=BashAction(command="sleep 0.5; echo finished", session="no-timeout", timeout=None),
+            idempotency_key=str(uuid.uuid4()),
+        ))
+        await asyncio.sleep(0.15)
+        interim = await runtime.get_operation(GetOperationRequest(
+            session="no-timeout", operation_id=started.operation_id, wait_timeout=0.1
+        ))
+        assert interim.state in ("running", "waiting_input")
+        result, output = await wait_terminal(runtime, "no-timeout", started.operation_id)
+        assert result.state == "completed"
+        assert "finished" in output
+        await runtime.close()
+    run(scenario())
+
