+"""Tests for SWE-ReX background Bash operations.
+
+Run with: python -m pytest tests/test_background_operations.py
+"""
+import asyncio
+import uuid
+
+import pytest
+
+from swerex.runtime.abstract import (
+    BashAction,
+    CreateBashSessionRequest,
+    CloseBashSessionRequest,
+    GetOperationRequest,
+    InterruptOperationRequest,
+    ResizeTerminalRequest,
+    SendInputRequest,
+    StartOperationRequest,
+)
+from swerex.runtime.dummy import DummyRuntime
+from swerex.runtime.local import LocalRuntime, _OutputCapture
+
+
+def run(coro):
+    return asyncio.run(coro)
+
+
+async def wait_terminal(runtime, session, operation_id, cursor=0, timeout=5.0):
+    deadline = asyncio.get_running_loop().time() + timeout
+    chunks = []
+    while asyncio.get_running_loop().time() < deadline:
+        result = await runtime.get_operation(GetOperationRequest(
+            session=session, operation_id=operation_id, cursor=cursor, wait_timeout=0.2
+        ))
+        chunks.append(result.output)
+        cursor = result.next_cursor
+        if result.state not in ("running", "waiting_input"):
+            return result, "".join(chunks)
+    raise AssertionError(f"operation {operation_id} did not finish: state={result.state}, failure={result.failure_reason!r}, output={result.output!r}")
+
+
+def test_output_stream_and_idempotent_start():
+    async def scenario():
+        runtime = LocalRuntime()
+        await runtime.create_session(CreateBashSessionRequest(session="stream"))
+        key = str(uuid.uuid4())
+        request = StartOperationRequest(
+            action=BashAction(command="printf one; sleep 0.15; printf two", session="stream"),
+            idempotency_key=key,
+        )
+        first = await runtime.start_operation(request)
+        duplicate = await runtime.start_operation(request)
+        assert duplicate.operation_id == first.operation_id
+        result, output = await wait_terminal(runtime, "stream", first.operation_id)
+        assert result.state == "completed"
+        assert result.exit_code == 0
+        assert "onetwo" in output
+        assert "SHELLPS1PREFIX" not in output
+        assert "REXEXIT" not in output
+        assert "EXITCODESTART" not in output
+        await runtime.close()
+    run(scenario())
+
+
+def test_interactive_prompt_and_input():
+    async def scenario():
+        runtime = LocalRuntime()
+        await runtime.create_session(CreateBashSessionRequest(session="interactive"))
+        await runtime.resize_terminal(ResizeTerminalRequest(
+            session="interactive", rows=40, cols=120
+        ))
+        started = await runtime.start_operation(StartOperationRequest(
+            action=BashAction(
+                command='read -p "Name? " name; echo "Hi $name"',
+                session="interactive",
+                expect=[r"Name\? "],
+            ),
+            idempotency_key=str(uuid.uuid4()),
+        ))
+        deadline = asyncio.get_running_loop().time() + 3
+        while True:
+            state = await runtime.get_operation(GetOperationRequest(
+                session="interactive", operation_id=started.operation_id
+            ))
+            if state.state == "waiting_input":
+                break
+            assert asyncio.get_running_loop().time() < deadline
+            await asyncio.sleep(0.02)
+        await runtime.send_input(SendInputRequest(
+            session="interactive", operation_id=started.operation_id, input="Ada"
+        ))
+        result, output = await wait_terminal(runtime, "interactive", started.operation_id)
+        assert result.state == "completed"
+        assert "Hi Ada" in output
+        await runtime.close()
+    run(scenario())
+
+
+def test_interrupt_is_operation_specific_and_shell_survives():
+    async def scenario():
+        runtime = LocalRuntime()
+        await runtime.create_session(CreateBashSessionRequest(session="interrupt"))
+        first = await runtime.start_operation(StartOperationRequest(
+            action=BashAction(command="echo first", session="interrupt"),
+            idempotency_key=str(uuid.uuid4()),
+        ))
+        await wait_terminal(runtime, "interrupt", first.operation_id)
+        second = await runtime.start_operation(StartOperationRequest(
+            action=BashAction(command="sleep 60", session="interrupt"),
+            idempotency_key=str(uuid.uuid4()),
+        ))
+        await asyncio.sleep(0.1)
+        stale = await runtime.interrupt_operation(InterruptOperationRequest(
+            session="interrupt", operation_id=first.operation_id
+        ))
+        assert stale.state == "completed"
+        active = await runtime.get_operation(GetOperationRequest(
+            session="interrupt", operation_id=second.operation_id
+        ))
+        assert active.state in ("running", "waiting_input")
+        stopped = await runtime.interrupt_operation(InterruptOperationRequest(
+            session="interrupt", operation_id=second.operation_id
+        ))
+        assert stopped.state == "interrupted"
+        assert stopped.exit_code in (130, None)
+        legacy = await runtime.run_in_session(BashAction(command="echo shell-ok", session="interrupt"))
+        assert legacy.exit_code == 0
+        assert "shell-ok" in legacy.output
+        await runtime.close()
+    run(scenario())
+
