+import asyncio
+
+from swerex.runtime.abstract import (
+    BashAction,
+    GetOperationRequest,
+    InterruptOperationRequest,
+    ResizeTerminalRequest,
+    SendInputRequest,
+    StartOperationRequest,
+    StartOperationResponse,
+    GetOperationResponse,
+)
+from swerex.runtime.remote import RemoteRuntime
+
+
+def test_remote_runtime_operation_methods_use_expected_routes_and_wait_timeout():
+    async def scenario():
+        runtime = RemoteRuntime(host="http://127.0.0.1", port=12345, auth_token="")
+        calls = []
+
+        async def fake_request(
+            endpoint, payload, output_class, num_retries=0,
+            request_timeout=None, disable_request_timeout=False,
+        ):
+            calls.append((endpoint, payload, output_class, num_retries, request_timeout, disable_request_timeout))
+            if output_class is StartOperationResponse:
+                return StartOperationResponse(
+                    operation_id="op", session="main", state="running", created_at=1
+                )
+            if output_class is GetOperationResponse:
+                return GetOperationResponse(
+                    operation_id="op", session="main", state="completed",
+                    created_at=1, started_at=1, finished_at=2,
+                )
+            return {}
+
+        runtime._request = fake_request
+        start = await runtime.start_operation(StartOperationRequest(
+            action=BashAction(command="echo x", session="main"),
+            idempotency_key="stable-key",
+        ))
+        assert start.operation_id == "op"
+
+        await runtime.get_operation(GetOperationRequest(
+            session="main", operation_id="op", wait_timeout=37
+        ))
+        await runtime.interrupt_operation(InterruptOperationRequest(
+            session="main", operation_id="op"
+        ))
+        await runtime.send_input(SendInputRequest(
+            session="main", operation_id="op", input="y"
+        ))
+        await runtime.resize_terminal(ResizeTerminalRequest(
+            session="main", rows=40, cols=120
+        ))
+
+        assert [call[0] for call in calls] == [
+            "start_operation", "get_operation", "interrupt_operation",
+            "send_input", "resize_terminal",
+        ]
+        assert calls[0][3] == 2
+        assert calls[1][4] == 47
+        assert calls[0][5] is True
+        assert calls[2][5] is True
+    asyncio.run(scenario())
