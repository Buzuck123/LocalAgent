+@dataclass
+class _OutputCapture:
+    max_chars: int = 1_048_576
+    prompt: str = ""
+    exit_prefix: str = ""
+    exit_suffix: str = ""
+    chunks: list[str] = field(default_factory=list)
+    chars: int = 0
+    total_chars: int = 0
+    pending: str = ""
+    changed: asyncio.Event = field(default_factory=asyncio.Event)
+
+    def _append(self, value: str) -> None:
+        if not value:
+            return
+        self.chunks.append(value)
+        self.chars += len(value)
+        self.total_chars += len(value)
+        while self.chars > self.max_chars and self.chunks:
+            excess = self.chars - self.max_chars
+            first = self.chunks[0]
+            if len(first) <= excess:
+                self.chunks.pop(0)
+                self.chars -= len(first)
+            else:
+                self.chunks[0] = first[excess:]
+                self.chars -= excess
+        self.changed.set()
+
+    def write(self, value: str) -> int:
+        if not value:
+            return 0
+        text = self.pending + value
+        self.pending = ""
+        if self.prompt:
+            text = text.replace(self.prompt, "")
+        if self.exit_prefix and self.exit_suffix:
+            marker = re.escape(self.exit_prefix) + r"\d+" + re.escape(self.exit_suffix)
+            text = re.sub(marker, "", text)
+            marker_start = text.rfind(self.exit_prefix)
+            if marker_start >= 0 and self.exit_suffix not in text[marker_start:]:
+                text, self.pending = text[:marker_start], text[marker_start:]
+
+        # Hold a possible partial internal token at the end of a PTY chunk so
+        # markers split across reads are never leaked to the client.
+        tokens = [token for token in (self.prompt, self.exit_prefix, self.exit_suffix) if token]
+        hold_at = len(text)
+        for token in tokens:
+            upper = min(len(token) - 1, len(text))
+            for size in range(upper, 0, -1):
+                if text.endswith(token[:size]):
+                    hold_at = min(hold_at, len(text) - size)
+                    break
+        if hold_at < len(text):
+            self.pending = text[hold_at:] + self.pending
+            text = text[:hold_at]
+        self._append(text)
+        return len(value)
+
+    def finish(self) -> None:
+        pending = self.pending
+        self.pending = ""
+        # A trailing partial prompt/exit marker is internal protocol data.
+        if any(token.startswith(pending) for token in (self.prompt, self.exit_prefix, self.exit_suffix) if token):
+            return
+        if self.exit_prefix and pending.startswith(self.exit_prefix):
+            return
+        self._append(pending)
+
+    def flush(self) -> None:
+        return None
+
+    @property
+    def oldest_cursor(self) -> int:
+        return self.total_chars - self.chars
+
+    def read(self, cursor: int, limit: int) -> tuple[str, int, int, bool]:
+        oldest = self.oldest_cursor
+        truncated = cursor < oldest
+        pos = max(cursor, oldest)
+        pieces: list[str] = []
+        remaining = max(0, limit)
+        offset = oldest
+        for chunk in self.chunks:
+            end = offset + len(chunk)
+            if end > pos and remaining:
+                start = max(0, pos - offset)
+                piece = chunk[start:start + remaining]
+                pieces.append(piece)
+                remaining -= len(piece)
+                pos += len(piece)
+            offset = end
+            if not remaining:
+                break
+        return "".join(pieces), pos, oldest, truncated
