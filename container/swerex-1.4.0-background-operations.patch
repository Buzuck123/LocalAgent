+def test_event_loop_remains_responsive_during_command():
+    async def scenario():
+        runtime = LocalRuntime()
+        await runtime.create_session(CreateBashSessionRequest(session="responsive"))
+        started = await runtime.start_operation(StartOperationRequest(
