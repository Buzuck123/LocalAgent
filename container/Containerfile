FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
    HOME=/root

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Base OS, Python, development tools and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    wget \
    git \
    nano \
    vim-tiny \
    less \
    file \
    jq \
    zip \
    unzip \
    p7zip-full \
    tar \
    gzip \
    xz-utils \
    procps \
    privoxy \
    iproute2 \
    iputils-ping \
    dnsutils \
    netcat-openbsd \
    lsof \
    build-essential \
    pkg-config \
    patch \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    python-is-python3 \
    sqlite3 \
    libsqlite3-dev \
    ffmpeg \
    poppler-utils \
    qpdf \
    tesseract-ocr \
    imagemagick \
    libreoffice-calc \
    libreoffice-writer \
    fonts-liberation \
    fonts-dejavu-core \
    fonts-crosextra-carlito \
    fonts-crosextra-caladea \
    fonts-noto-core \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libopenjp2-7-dev \
    && rm -rf /var/lib/apt/lists/*

# Python libraries
COPY requirements.txt /tmp/requirements.txt

COPY patch_swerex_ansi.py /tmp/patch_swerex_ansi.py
COPY patch_swerex_background.py /tmp/patch_swerex_background.py
COPY swerex-1.4.0-background-operations.patch /tmp/swerex-1.4.0-background-operations.patch

RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# LocalAgent web search CLI
COPY pyproject.toml /tmp/localagent-web-search/pyproject.toml
COPY web_search /tmp/localagent-web-search/web_search
COPY localagent_http /tmp/localagent-web-search/localagent_http

RUN python3 -m pip install --no-cache-dir /tmp/localagent-web-search \
    && rm -rf /tmp/localagent-web-search

RUN python3 /tmp/patch_swerex_background.py \
    && rm /tmp/patch_swerex_background.py /tmp/swerex-1.4.0-background-operations.patch

RUN python3 /tmp/patch_swerex_ansi.py \
    && rm /tmp/patch_swerex_ansi.py

# Chromium and its runtime dependencies
RUN python3 -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# Configure automatic HTTP proxy through Xray SOCKS5
COPY privoxy.conf /etc/privoxy/config
COPY entrypoint.sh /usr/local/bin/container-entrypoint
COPY swerex_server.py /usr/local/bin/localagent-swerex-server.py
RUN chmod 755 /usr/local/bin/container-entrypoint /usr/local/bin/localagent-swerex-server.py \
    && (getent group privoxy >/dev/null || groupadd --system privoxy) \
    && (getent passwd privoxy >/dev/null || useradd --system --gid privoxy --no-create-home --home-dir /var/empty --shell /usr/sbin/nologin privoxy) \
    && mkdir -p /var/log/privoxy \
    && chown -R privoxy:privoxy /var/log/privoxy

ENV HTTP_PROXY=http://127.0.0.1:8118 \
    HTTPS_PROXY=http://127.0.0.1:8118 \
    ALL_PROXY=http://127.0.0.1:8118 \
    http_proxy=http://127.0.0.1:8118 \
    https_proxy=http://127.0.0.1:8118 \
    all_proxy=http://127.0.0.1:8118 \
    NO_PROXY=localhost,127.0.0.1 \
    no_proxy=localhost,127.0.0.1

# Working directory
WORKDIR /workspace

# Start proxy automatically and keep the container alive
ENTRYPOINT ["/usr/local/bin/container-entrypoint"]
